# Backend Environment Configuration
PORT=3001
HOST=0.0.0.0
MERCHANT_NAME=MGOCSM Jaipur
MERCHANT_UPI_ID=mgocsmjaipur@nsdl
MERCHANT_CATEGORY_CODE=5411

# Database File Path
DATABASE_PATH=../database/upi_display.db

# Device Token for Authenticating Android Phone Listener
ANDROID_DEVICE_TOKEN=upi_secure_token_987654321

# Payment Provider mode: 'demo' | 'notification' | 'gateway' | 'hybrid'
PAYMENT_PROVIDER=hybrid

# Gateway Webhook HMAC Secret (if using Razorpay/Cashfree/Bank webhook)
GATEWAY_WEBHOOK_SECRET=secret_webhook_signature_key_upi

# Active session expiration in seconds (default 5 minutes)
SESSION_TIMEOUT_SECONDS=300

# Delay before auto-returning to ready screen after successful payment (in seconds)
AUTO_RESET_DELAY_SECONDS=7

# CORS Allowed Origin
CORS_ORIGIN=*
NODE_ENV=development
